<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Account cookies/tokens are stored in DataStore; never system-back them up. -->
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
    <exclude domain="file" path="./capsule-last-crash.txt" />
    <exclude domain="file" path="./download-artwork/" />
    <exclude domain="file" path="./external-artwork/" />
</full-backup-content>